{
  "name": "booking-manager",
  "productName": "Booking Manager",
  "version": "0.1.0",
  "private": true,
  "description": "Booking Manager for Sundeep Freight Movers",
  "main": "dist-electron/electron/main.js",
  "scripts": {
    "postinstall": "electron-rebuild -f -w better-sqlite3",
    "typecheck": "tsc -p tsconfig.web.json --noEmit && tsc -p tsconfig.node.json --noEmit",
    "dev": "tsc -p tsconfig.node.json && concurrently -P -k -n vite,app \"vite\" \"wait-on tcp:127.0.0.1:5173 && electron . --dev {@}\" --",
    "build:node": "tsc -p tsconfig.node.json",
    "build": "npm run typecheck && vite build && npm run build:node",
    "clean:node": "node -e \"require('fs').rmSync('dist-electron',{recursive:true,force:true})\"",
    "test:db": "node scripts/test-db.cjs",
    "check": "npm run typecheck && eslint . --max-warnings 0 && npm run clean:node && npm run build:node && cd dist-electron && node --test && cd .. && npm run test:db",
    "dist": "npm run clean:node && npm run build && electron-builder --publish never"
  },
  "dependencies": {
    "better-sqlite3": "12.11.1"
  },
  "devDependencies": {
    "@electron/rebuild": "4.2.0",
    "@eslint/js": "9.39.5",
    "@fontsource/inter": "5.3.0",
    "@fontsource/plus-jakarta-sans": "5.3.0",
    "@types/better-sqlite3": "9.6.0",
    "@types/node": "16.18.126",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "5.2.0",
    "concurrently": "9.2.5",
    "electron": "22.3.27",
    "electron-builder": "26.15.3",
    "eslint": "9.39.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "lucide-react": "1.59.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.0",
    "vite": "7.3.7",
    "wait-on": "8.0.5"
  },
  "build": {
    "appId": "com.sundeepfreight.bookingmanager",
    "productName": "Booking Manager",
    "electronVersion": "22.3.27",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "!**/*.test.js",
      "!**/*.dbtest.js",
      "!**/*.map",
      "!dist-electron/keeper/testing.js",
      "!**/*.{lib,exp,iobj,ipdb,pdb}",
      "!dist-electron/src/logic/**",
      "!node_modules/better-sqlite3/{deps,src,bin}/**",
      "!node_modules/better-sqlite3/build/{deps,Release/obj}/**",
      "!node_modules/better-sqlite3/build/*.vcxproj*",
      "!node_modules/better-sqlite3/build/Release/test_extension.node"
    ],
    "asarUnpack": [
      "node_modules/better-sqlite3/**/*"
    ],
    "npmRebuild": false,
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.png"
    },
    "nsis": {
      "artifactName": "Booking Manager-Setup-${version}.${ext}",
      "oneClick": false,
      "perMachine": true,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Booking Manager",
      "warningsAsErrors": false
    }
  }
}
